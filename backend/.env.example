# ============================================================
# SADITA Backend — Environment Variables Example
# Copy to .env and fill in values
# ============================================================

# --- Application ---
APP_NAME=SADITA
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=sadita_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres@localhost:5433/sadita_db

# --- JWT ---
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MQTT ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=sadita-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60
MQTT_TLS_ENABLED=false

# --- Upload ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# --- Gemini AI (Phase 6 only) ---
GEMINI_API_KEY=
